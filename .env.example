# Copy to .env (never commit .env). Values here are placeholders, not secrets.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/planning?schema=public"

# --- Sessions / cookies ---
# COOKIE_SECURE defaults to true when NODE_ENV=production. Set false only for plain-HTTP local use.
# COOKIE_SECURE=true
# SESSION_TTL_HOURS=12
# SESSION_IDLE_MINUTES=60

# --- Reverse proxy ---
# Set true only when the app sits behind the bundled Caddy (which overwrites X-Real-IP / X-Forwarded-*).
# TRUST_PROXY=true
# Extra origins allowed to send state-changing requests and open realtime sockets (comma separated).
# ALLOWED_ORIGINS=https://planning.example.com
# Enable only where the site is really served over HTTPS.
# ENABLE_HSTS=true
# Caddy site address. A hostname enables automatic HTTPS; default is :81 (plain HTTP behind a TLS gateway).
# SITE_ADDRESS=planning.example.com

# --- Realtime notifications (shared by the app and mini-services/notifications-service) ---
# 32+ random characters, e.g. `openssl rand -base64 48`. Without it, broadcasting is disabled.
# NOTIFY_SERVICE_TOKEN=
# NOTIFY_INTERNAL_URL=http://127.0.0.1:3001
# APP_INTERNAL_URL=http://127.0.0.1:3000
# NOTIFY_DEMO_EVENTS=false

# --- API limits ---
# API_PAGE_DEFAULT=500
# API_PAGE_MAX=2000
# API_SCAN_MAX=50000

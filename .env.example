# Copy to .env (never commit .env). Values here are placeholders, not secrets.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/planning?schema=public"

# --- Sessions / cookies ---
# COOKIE_SECURE defaults to true when NODE_ENV=production. Set false only for plain-HTTP local use.
# COOKIE_SECURE=true
# SESSION_TTL_HOURS=12
# SESSION_IDLE_MINUTES=60

# --- Reverse proxy ---
# Set true only when the app sits behind the bundled Caddy (which overwrites X-Real-IP / X-Forwarded-*).
# TRUST_PROXY=true
# Extra origins allowed to send state-changing requests (comma separated).
# ALLOWED_ORIGINS=https://planning.example.com
# Enable only where the site is really served over HTTPS.
# ENABLE_HSTS=true
# Caddy site address. A hostname enables automatic HTTPS; default is :81 (plain HTTP behind a TLS gateway).
# SITE_ADDRESS=planning.example.com

# --- Sign-in screen daily quote ---
# Source for the login page's Daily Motivation. "zenquotes" (default) fetches
# https://zenquotes.io/api/today server-side once per business day and caches it;
# "local" disables the outbound call entirely for offline/air-gapped installs.
# Either way an upstream failure falls back to the built-in quote list and never
# blocks sign-in.
# MOTIVATION_SOURCE=zenquotes
# Business day boundary for the quote (and all analytics windows).
# ANALYTICS_TIMEZONE=Asia/Kolkata

# --- API limits ---
# API_PAGE_DEFAULT=500
# API_PAGE_MAX=2000
# API_SCAN_MAX=50000

# --- Sarin CSV import limits ---
# Whole positive integers; an invalid or over-ceiling value falls back to the default and
# is logged. The file limit can never exceed 10,420,224 bytes: uploads pass through the
# Next.js proxy, which buffers at most 10 MiB and would silently truncate anything larger.
# SARIN_IMPORT_MAX_FILE_BYTES=8388608
# SARIN_IMPORT_MAX_RECORDS=150000
# SARIN_IMPORT_MAX_LINE_BYTES=4096
# SARIN_IMPORT_MAX_FIELD_CHARS=256
# SARIN_IMPORT_ROW_INSERT_BATCH=1000
# SARIN_IMPORT_TRANSACTION_TIMEOUT_MS=120000

# --- Sarin validation limits ---
# One validation attempt runs in one transaction. Its claim lease is always this timeout
# plus 5 minutes, so a live worker can never be reclaimed; a crashed one can after that.
# SARIN_VALIDATION_TRANSACTION_TIMEOUT_MS=600000
# SARIN_VALIDATION_WRITE_BATCH=500

# --- Sarin output generation limits ---
# One output version is generated in one transaction, written in rounds of
# this many stones. A generation waits up to 30 seconds for another one on the same batch.
# SARIN_OUTPUT_TRANSACTION_TIMEOUT_MS=600000
# SARIN_OUTPUT_WRITE_BATCH=200
# Largest output version (in pieces) one export may contain; larger ones are refused.
# SARIN_OUTPUT_EXPORT_MAX_ROWS=150000

# --- Fantasy ERP data source & live integration (backend only — never NEXT_PUBLIC_*) ---
# Which data source the application uses. There is no implicit default: an absent, empty or
# unsupported value resolves to NOT_CONFIGURED and fails closed rather than running on fixtures.
#   FIXTURE_SIMULATION  built-in simulation fixtures (legacy value: FIXTURE)
#   LIVE_FANTASY        the live Fantasy Web API below (legacy value: FANTASY_API). The scheduled
#                       Live Data sync runs, but the reported source state stays NOT_CONFIGURED
#                       until a provider is registered in provider-registry.server.ts.
# FILE_IMPORT is not a supported value and is refused during configuration validation.
FANTASY_SOURCE_MODE=FIXTURE_SIMULATION
FANTASY_API_BASE_URL=https://skylab.fantasy.mn:7600
FANTASY_API_USERNAME=
# Plain value, or an enc:v1: envelope (AES-256-GCM under SECRETS_KEY) produced by:
#   npm run secret:encrypt -- --new-key      → prints a SECRETS_KEY to put here
#   SECRET_VALUE='…' npm run secret:encrypt  → prints the envelope to paste below
# The plaintext is decrypted only in server memory for the login call; it is never stored in the
# database, logged, or returned by any route.
FANTASY_API_PASSWORD=
SECRETS_KEY=
# Lot listing path on the Fantasy host (the vendor's /api/lots list currently errors server-side).
FANTASY_API_LOTS_PATH=/api/lots
FANTASY_API_TIMEOUT_MS=30000
# Vendor pagination query-string names; leave empty while the listing is a single response.
FANTASY_API_PAGE_PARAM=
FANTASY_API_PAGE_SIZE_PARAM=
FANTASY_SYNC_ENABLED=true
FANTASY_SYNC_INTERVAL_MINUTES=5
FANTASY_SYNC_INITIAL_DELAY_SECONDS=20
FANTASY_SYNC_PAGE_SIZE=500
FANTASY_SYNC_MAX_RETRIES=3
# Above this share of active rows missing from a snapshot, nothing is marked stale (PARTIAL run).
FANTASY_SYNC_STALE_GUARD_PERCENT=25
# After each successful live sync, also refresh the planning engine's canonical lot store.
FANTASY_SYNC_CHAIN_PLANNING=true
# Country/branch recorded for planning when the listing has no such columns.
FANTASY_API_DEFAULT_COUNTRY=IN
FANTASY_API_DEFAULT_BRANCH=SURAT

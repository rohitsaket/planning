model FantasyProjectionRun {
  id                           String    @id @default(cuid())
  /// DRY_RUN (nothing persisted beyond this run row) | SHADOW (candidates persisted).
  /// ACTIVE is refused by a CHECK constraint, not merely by application code.
  mode                         String
  status                       String
  /// Deterministic hash over every material input: batch id and content hash, mode,
  /// contract and encoding versions, classification profile and version, identity
  /// policy, measurement policy, quantity semantics and weight unit.
  ///
  /// This is the LOGICAL IDENTITY of the requested projection, not a unique row key. It
  /// was globally unique until the attempt model replaced that: a crashed or failed run
  /// then permanently blocked its own work, and the only escape was to alter an input to
  /// manufacture a different fingerprint — which falsifies what the operation is.
  fingerprint                  String
  /// 1 for the first attempt at this fingerprint, incrementing per retry. Attempts are
  /// append-only: a retry never deletes, reuses or overwrites an earlier attempt.
  attemptNumber                Int       @default(1)
  /// The attempt this one retries, when any. Deliberately a plain column rather than a
  /// self-relation, so an attempt chain can be read without a recursive include.
  previousAttemptId            String?
  /// Optimistic concurrency. Every ownership-sensitive write supplies the version it read.
  version                      Int       @default(0)
  /// SHA-256 of the worker's claim token. The token itself exists only in the worker's
  /// memory and is never stored, logged or returned. A worker proves ownership by
  /// presenting the token; an aborted attempt has this cleared, which is what makes the
  /// old worker's next write fail.
  ownerTokenHash               String?
  /// Advanced as each page commits. Read-only evidence of liveness — nothing aborts a
  /// run on the strength of it, because an invented timeout would kill healthy long runs.
  heartbeatAt                  DateTime?
  abortedAt                    DateTime?
  abortedByUserId              String?
  /// Fixed code from the abort vocabulary. Never free text.
  abortReasonCode              String?
  /// Bounded operator note. Length-limited and validated at the API boundary.
  abortReasonNote              String?
  /// Fixed code describing how a non-completed attempt ended, for the diagnostics list.
  terminalReasonCode           String?
  /// The raw batch projected. A real foreign key with RESTRICT: raw evidence cannot be
  /// deleted while a projection cites it.
  sourceBatchId                String?
  sourceBatch                  FantasyRawBatch? @relation(fields: [sourceBatchId], references: [id], onDelete: Restrict)
  contractVersion              String
  encodingVersion              String?
  /// Effective source state at the time of the run, so a fixture projection can never be
  /// mistaken for a live one after the fact.
  effectiveSourceState         String
  /// Classification inputs, recorded so a candidate stays reproducible after a mapping edit.
  classificationProfile        String?
  classificationProfileVersion Int?
  /// Identity policy that produced every candidate's projectionIdentityKey.
  identityPolicyVersion        Int
  /// Measurement resolution policy in force. STRICT_ACTUAL_ONLY means no estimate was
  /// ever promoted into a usable value.
  measurementPolicy            String    @default("STRICT_ACTUAL_ONLY")
  quantitySemantics            String
  weightUnit                   String
  rowsRead                     Int       @default(0)
  /// Rows whose ingestion outcome was ACCEPTED_RAW — the only rows that may be decoded
  /// and projected into canonical candidate fields.
  rowsEligible                 Int       @default(0)
  /// Rows skipped before any decoding, counted by why. A skipped row produces no
  /// candidate at all, so it can never enter reconciliation as a business record.
  rowsSkippedQuarantined       Int       @default(0)
  rowsSkippedRejected          Int       @default(0)
  rowsSkippedNotNormalized     Int       @default(0)
  rowsSkippedUndecodable       Int       @default(0)
  /// Candidates actually written, by state. These count rows, not skips.
  candidatesProjected          Int       @default(0)
  candidatesQuarantined        Int       @default(0)
  candidatesReviewRequired     Int       @default(0)
  /// Fixed diagnostic codes and counts only. Never a source value or a raw payload.
  diagnosticsJson              String?
  /// Constant, surfaced in diagnostics so the UI never has to infer why nothing was promoted.
  activationBlockedReason      String    @default("ACTIVATION_NOT_IMPLEMENTED")
  requestedByUserId            String?
  startedAt                    DateTime  @default(now())
  completedAt                  DateTime?
  createdAt                    DateTime  @default(now())

  candidates                   FantasyProjectionCandidate[]

  /// One row per attempt at a logical projection. The "only one RUNNING" and "only one
  /// COMPLETED" rules are partial unique indexes created in the migration — Prisma has no
  /// syntax for them, so they exist in SQL and are verified by test.
  @@unique([fingerprint, attemptNumber])
  @@index([mode, status])
  @@index([sourceBatchId])
  @@index([startedAt])
  @@index([classificationProfile, classificationProfileVersion])
  @@index([fingerprint, status])
  @@index([status, heartbeatAt])
  @@index([requestedByUserId, status])
  @@index([requestedByUserId, startedAt])
}

/// Immutable. Written once by a projection run and never updated: there is no
/// `updatedAt`, and the service performs no update or upsert against this model. A
/// corrected projection is a new run, so the two can be compared.
model FantasyProjectionCandidate {
  id                           String   @id @default(cuid())
  runId                        String
  /// RESTRICT, not CASCADE: a projection run must not be able to delete the candidates
  /// that are the evidence for what it concluded.
  run                          FantasyProjectionRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  /// Denormalized copy of the run's batch id, kept as a plain column. The batch is
  /// already reachable through the run's foreign key; a second key to the same table
  /// would add a redundant RESTRICT path without adding any integrity.
  sourceBatchId                String?
  /// The raw row this candidate was projected from. RESTRICT preserves the evidence.
  sourceRowId                  String?
  sourceRow                    FantasyRawRow? @relation(fields: [sourceRowId], references: [id], onDelete: Restrict)
  sourceRowNumber              Int
  /// Content hash of the raw row this candidate was projected from.
  rowHash                      String

  /// --- Identity (policy II: additive, legacy lotId never dropped) -----------
  /// Deterministic business identity under identityPolicyVersion. Not assumed unique
  /// across companies; a collision is recorded as a review reason rather than thrown.
  projectionIdentityKey        String
  identityPolicyVersion        Int
  sourceCompanyId              String?
  /// The legacy identifier, preserved verbatim so existing records remain matchable.
  legacyLotId                  String?
  lotName                      String?
  certificateNumber            String?
  certificateId                String?
  documentId                   String?
  documentDateRaw              String?
  allocationAccountId          String?
  allocationDateRaw            String?
  processName                  String?
  departmentAccountName        String?
  previousDepartmentAccountName String?

  /// --- Source values driving classification, kept verbatim for review ------
  lotStatusRaw                 String?
  onHoldRaw                    String?

  /// --- Canonical classification -------------------------------------------
  holdState                    String?
  canonicalLifecycle           String?
  inventoryClass               String?
  classificationAvailable      Boolean?
  classificationPlanningEligible Boolean?
  classificationReviewRequired Boolean?
  classificationTerminal       Boolean?
  classificationReasons        String?
  classificationProfile        String?
  classificationProfileVersion Int?
  classificationState          String?

  /// --- Measured attributes -------------------------------------------------
  /// Preserved exactly as supplied. Never written from an estimate.
  actualShape                  String?
  actualColor                  String?
  actualClarity                String?
  actualLabName                String?
  actualCut                    String?
  actualPolish                 String?
  actualSymmetry               String?
  actualFluorescence           String?
  actualTable                  String?
  actualDepth                  String?
  actualRatio                  String?
  actualTone                   String?
  actualFancyColor             String?
  /// Populated only when `Weight` parsed. A rejected value leaves this null and records
  /// its reason code, rather than becoming zero.
  actualWeight                 Decimal?
  actualWeightState            String?

  /// --- Estimated attributes, stored separately and never merged ------------
  /// Opaque provider identifiers. Not grades, and not resolved without an approved lookup.
  estimatedShapeId             String?
  estimatedColorId             String?
  estimatedClarityId           String?
  estimatedShapeIdState        String?
  estimatedColorIdState        String?
  estimatedClarityIdState      String?
  estimatedWeight              Decimal?
  estimatedWeightState         String?
  /// Difference between the two raw weight numbers when both parsed. Advisory only: the
  /// two fields have separately unconfirmed units, so this is not a correction.
  weightDivergence             Decimal?

  /// --- Provenance ----------------------------------------------------------
  shapeProvenance              String   @default("NONE")
  colorProvenance              String   @default("NONE")
  clarityProvenance            String   @default("NONE")
  weightProvenance             String   @default("NONE")
  estimationMethod             String   @default("NOT_ESTIMATED")
  containsEstimatedValues      Boolean  @default(false)
  /// True only when every usable attribute is measured, so the record may count against
  /// confirmed physical shortage.
  eligibleForConfirmedShortage Boolean  @default(false)

  /// --- Quantity and weight safety -----------------------------------------
  quantityRawValue             Decimal?
  quantityState                String
  quantityPieces               Int?
  quantitySemantics            String
  weightUnit                   String
  /// Set only when a unit profile is configured and the measured weight parsed.
  weightUsableCarats           Decimal?
  /// Parsed secondary weights, each kept separate. No relationship between them is assumed.
  averageWeight                Decimal?
  originalWeight               Decimal?
  totalDiamondWeight           Decimal?
  metalWeight                  Decimal?
  metWeight                    Decimal?
  /// Per-field rejection codes for the secondary weights. Codes only.
  secondaryWeightStatesJson    String?
  /// `Size`, `M1`, `M2`, `M3` preserved verbatim under keys marked unconfirmed. They are
  /// carried so nothing is lost, and interpreted nowhere.
  unconfirmedDimensionsJson    String?

  /// --- Structure (jewellery / multi-stone protection) ----------------------
  metalId                      String?
  metalColorRaw                String?
  itemName                     String?
  structureReviewRequired      Boolean  @default(false)
  /// Comma-separated fixed risk codes. Never free text.
  structureRiskCodes           String?

  /// PROJECTED | REVIEW_REQUIRED | QUARANTINED
  candidateState               String
  /// Comma-separated fixed reason codes explaining review or quarantine.
  reviewReasonCodes            String?

  createdAt                    DateTime @default(now())

  /// One candidate per source row per run; a re-run is a new run, never an overwrite.
  @@unique([runId, sourceRowNumber])
  @@index([runId, candidateState])
  @@index([projectionIdentityKey])
  @@index([legacyLotId])
  @@index([runId, inventoryClass])
  @@index([rowHash])
}

/// Immutable metadata of an uploaded Sarin file. The bytes live in
/// SarinSourceFileContent so that no ordinary query on this model can load them.
model SarinSourceFile {
  id                String   @id @default(cuid())
  /// Lowercase hex SHA-256 of the exact bytes; verified against the content by the database.
  sha256            String   @unique
  /// As supplied by the client. Display and audit only: never a path, never a header value.
  originalFileName  String
  sanitizedFileName String
  byteSize          Int
  detectedEncoding  String
  createdAt         DateTime @default(now())

  content SarinSourceFileContent?
  batches SarinImportBatch[]
}

/// The exact uploaded bytes, one row per source file. Insert-only.
model SarinSourceFileContent {
  sourceFileId String          @id
  sourceFile   SarinSourceFile @relation(fields: [sourceFileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  content      Bytes
  createdAt    DateTime        @default(now())
}

/// One declared-packet-type import of one source file, in an optional lab scope. Sarin
/// imports carry no country. The packet type has no default: it must be declared.
model SarinImportBatch {
  id                      String                @id @default(cuid())
  sourceFileId            String
  sourceFile              SarinSourceFile       @relation(fields: [sourceFileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Packet type BLUE | WHITE | PINK, declared by the uploader. Never inferred from Stone Name.
  packetType              String
  /// Optional; compared verbatim with UserAccessScope LAB values.
  labScope                String?
  /// Raw positional contract the rows were read against, e.g. SARIN_RAW_CSV_V1.
  contractVersion         String
  /// Business planning date declared by the uploader (date only, no time zone). Written
  /// to the structured output's DATE column later. Never defaulted by the server.
  planningDate            DateTime @db.Date
  /// Set when a transformation runs (later phase).
  transformProfileVersion String?
  /// Mapping set in force for the current validation attempt; must be APPROVED.
  shapeMappingSetId       String?
  shapeMappingSet         SarinShapeMappingSet? @relation(fields: [shapeMappingSetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// UPLOADED | VALIDATING | NEEDS_REVIEW | VALIDATED | FAILED | ARCHIVED.
  /// Transitions are enforced by a database trigger.
  status                  String                @default("UPLOADED")
  /// Safe diagnostic code, required while FAILED. Never a source value or stack trace.
  failureCode             String?
  /// Incremented by exactly one on every entry into VALIDATING.
  validationAttempt       Int                   @default(0)
  rowCount                Int                   @default(0)
  blockCount              Int                   @default(0)
  quarantinedRowCount     Int                   @default(0)
  quarantinedBlockCount   Int                   @default(0)
  uploadedByUserId        String
  statusChangedAt         DateTime              @default(now())
  /// Worker claim. All three are set together or cleared together.
  claimToken              String?
  claimedAt               DateTime?
  leaseExpiresAt          DateTime?
  /// Monotonic. Must increase whenever a new claim token is issued.
  fencingVersion          Int                   @default(0)
  archivedAt              DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  rows     SarinSourceRow[]
  blocks   SarinStoneBlock[]
  issues   SarinValidationIssue[]
  attempts SarinValidationAttempt[]
  outputs  SarinOutputVersion[]

  @@index([labScope, status])
  @@index([status, createdAt])
  @@index([sourceFileId])
  @@index([uploadedByUserId, createdAt])
}

/// One physical line of the source file, preserved exactly. Insert-only.
/// Typed values are NULL when the raw value was missing or invalid; they are never
/// coerced to zero. Pink plan codes are positional and are therefore not stored here.
model SarinSourceRow {
  id              String           @id @default(cuid())
  batchId         String
  batch           SarinImportBatch @relation(fields: [batchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// One-based physical line number within the file.
  sourceRowNumber Int
  rawLine         String
  fieldCount      Int
  /// Lowercase hex SHA-256 of rawLine.
  rowHash         String
  /// ACCEPTED | QUARANTINED | REJECTED_STRUCTURE.
  outcome         String
  /// JSON array of the record's fields exactly as read, one string per field. NULL only
  /// when the record's quoting could not be read at all.
  rawFieldsJson   String?
  /// Comma-separated reason codes, present exactly when the row is not ACCEPTED.
  rejectionCodes  String?
  stoneNameRaw    String?
  roughWeight     Decimal?         @db.Decimal(12, 3)
  shapeRaw        String?
  estimatedWeight Decimal?         @db.Decimal(12, 3)
  clarity         String?
  color           String?
  depthPct        Decimal?         @db.Decimal(9, 3)
  ratio           Decimal?         @db.Decimal(9, 3)
  length          Decimal?         @db.Decimal(9, 3)
  width           Decimal?         @db.Decimal(9, 3)
  depthMm         Decimal?         @db.Decimal(9, 3)
  createdAt       DateTime         @default(now())

  blocksStartingHere SarinStoneBlock[]      @relation("SarinStoneBlockFirstRow")
  blocksEndingHere   SarinStoneBlock[]      @relation("SarinStoneBlockLastRow")
  issues             SarinValidationIssue[]
  interpretations    SarinRowInterpretation[]
  planPieces         SarinPlanPiece[]

  @@unique([batchId, sourceRowNumber])
  @@unique([id, batchId])
  @@index([batchId, outcome])
}

/// A run of consecutive rows sharing one exact Stone Name. A repeated, non-consecutive
/// name is a separate block: nothing here merges them.
model SarinStoneBlock {
  id             String           @id @default(cuid())
  batchId        String
  batch          SarinImportBatch @relation(fields: [batchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  blockSequence  Int
  stoneNameRaw   String
  kapan          String?
  /// Text: leading zeros are part of the identifier.
  packet         String?
  signer         String?
  firstRowNumber Int
  firstRow       SarinSourceRow   @relation("SarinStoneBlockFirstRow", fields: [batchId, firstRowNumber], references: [batchId, sourceRowNumber], onDelete: Restrict, onUpdate: Restrict)
  lastRowNumber  Int
  lastRow        SarinSourceRow   @relation("SarinStoneBlockLastRow", fields: [batchId, lastRowNumber], references: [batchId, sourceRowNumber], onDelete: Restrict, onUpdate: Restrict)
  rowCount       Int
  roughWeight    Decimal?         @db.Decimal(12, 3)
  /// PENDING | PARSED | QUARANTINED. Leaves PENDING once and is then immutable.
  parseStatus    String           @default("PENDING")
  parsedAt       DateTime?
  createdAt      DateTime         @default(now())

  issues          SarinValidationIssue[]
  interpretations SarinRowInterpretation[]
  planOptions     SarinPlanOption[]

  @@unique([batchId, blockSequence])
  @@unique([id, batchId])
  @@index([batchId, parseStatus])
  @@index([batchId, kapan, packet])
}

/// A finding from one validation attempt. Identity columns are immutable; only the
/// status moves, and only along the transitions the trigger allows.
model SarinValidationIssue {
  id                String                @id @default(cuid())
  batchId           String
  batch             SarinImportBatch      @relation(fields: [batchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Must belong to the same batch (composite foreign key).
  stoneBlockId      String?
  stoneBlock        SarinStoneBlock?      @relation(fields: [stoneBlockId, batchId], references: [id, batchId], onDelete: Restrict, onUpdate: Restrict)
  /// Must belong to the same batch (composite foreign key).
  sourceRowId       String?
  sourceRow         SarinSourceRow?       @relation(fields: [sourceRowId, batchId], references: [id, batchId], onDelete: Restrict, onUpdate: Restrict)
  /// The batch's validation attempt when raised.
  validationAttempt Int
  /// The mapping set in force when raised (lineage).
  shapeMappingSetId String?
  shapeMappingSet   SarinShapeMappingSet? @relation(fields: [shapeMappingSetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Stable machine code, e.g. STONE_NAME_MALFORMED.
  code              String
  /// BLOCKING | ERROR | WARNING | INFO.
  severity          String
  blocking          Boolean
  /// One-based positional field (1-11) when the issue concerns one field.
  fieldPosition     Int?
  fieldName         String?
  /// Bounded JSON object of safe parameters. Never a full row or payload.
  parametersJson    String?
  /// OPEN | OVERRIDDEN | RESOLVED | SUPERSEDED.
  status            String                @default("OPEN")
  createdAt         DateTime              @default(now())
  resolvedAt        DateTime?
  resolvedByUserId  String?
  /// Position of the finding within its validation attempt, in the order raised: file order,
  /// then findings that span blocks. NULL only for issues written outside a validation run.
  ordinal           Int?

  overrides SarinIssueOverride[]

  @@index([batchId, status])
  @@index([batchId, severity])
  @@index([batchId, code])
  @@index([stoneBlockId])
  @@index([sourceRowId])
}

/// Append-only review decision on one issue. Each new decision supersedes the chain head
/// of the same issue; the effective override is the unsuperseded head unless that head is
/// a REVOCATION. Source rows are never changed by an override.
model SarinIssueOverride {
  id                   String               @id @default(cuid())
  issueId              String
  issue                SarinValidationIssue @relation(fields: [issueId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// ACKNOWLEDGE_WARNING | ASSIGN_NORMALIZED_SHAPE | REVOCATION.
  kind                 String
  /// Bounded JSON object carrying the validated decision, where the kind needs one.
  decisionJson         String?
  reason               String
  appliedByUserId      String
  /// The chain head this decision replaces; same issue (composite foreign key).
  supersedesOverrideId String?
  supersedes           SarinIssueOverride?  @relation("SarinOverrideChain", fields: [supersedesOverrideId, issueId], references: [id, issueId], onDelete: Restrict, onUpdate: Restrict)
  supersededBy         SarinIssueOverride?  @relation("SarinOverrideChain")
  createdAt            DateTime             @default(now())

  @@unique([id, issueId])
  @@unique([supersedesOverrideId, issueId])
  @@index([issueId, createdAt])
  @@index([appliedByUserId])
}

/// A versioned Sarin-to-ecosystem shape mapping. Independent of the Fantasy ShapeMapping
/// table, which keeps driving Fantasy category classification unchanged.
model SarinShapeMappingSet {
  id               String    @id @default(cuid())
  /// SARIN.
  sourceSystem     String
  version          Int
  /// DRAFT while a snapshot is being written; EFFECTIVE for the one current catalog;
  /// SUPERSEDED once a newer saved snapshot replaced it; ARCHIVED for a draft that was never
  /// used. APPROVED and RETIRED are records of the former approval workflow, kept as history.
  /// Rules are editable only while DRAFT.
  status           String    @default("DRAFT")
  /// MIGRATION_BASELINE for the set seeded from the confirmed master; SYSTEM for a snapshot
  /// a deployment installed (a client-confirmed rule); USER for one a user saved.
  origin           String
  description      String?
  /// Computed by the database from the rules when the set was approved or became effective.
  contentHash      String?
  createdByUserId  String?
  createdAt        DateTime  @default(now())
  approvedByUserId String?
  approvedAt       DateTime?
  retiredByUserId  String?
  retiredAt        DateTime?
  /// Who last changed the draft's rules or description. The approver must be neither the
  /// creator nor this person (enforced by the database on approval).
  lastModifiedByUserId String?
  lastModifiedAt       DateTime?
  /// The set this draft was cloned from. Fixed at creation.
  copiedFromSetId      String?
  copiedFrom           SarinShapeMappingSet?  @relation("SarinMappingClone", fields: [copiedFromSetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  copies               SarinShapeMappingSet[] @relation("SarinMappingClone")
  /// Set when this set was replaced: a retired approved set by its approved clone, or a
  /// superseded effective snapshot by the newer snapshot saved from it.
  supersededBySetId    String?                @unique
  supersededBy         SarinShapeMappingSet?  @relation("SarinMappingSupersession", fields: [supersededBySetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supersedes           SarinShapeMappingSet?  @relation("SarinMappingSupersession")
  /// When this snapshot became the effective catalog. Set by the database.
  effectiveAt          DateTime?
  /// When a newer saved snapshot replaced this one. Set by the database.
  supersededAt         DateTime?
  /// When this never-used draft was archived. Set by the database.
  archivedAt           DateTime?

  rules           SarinShapeMappingRule[]
  batches         SarinImportBatch[]
  issues          SarinValidationIssue[]
  attempts        SarinValidationAttempt[]
  interpretations SarinRowInterpretation[]
  outputVersions  SarinOutputVersion[]

  @@unique([sourceSystem, version])
  @@index([sourceSystem, status])
}

/// One mapping from a canonical raw Sarin shape key to an ecosystem shape, optionally
/// conditional on an inclusive Ratio range. Unknown raw shapes have no rule and are
/// quarantined by validation; there is no fallback rule.
model SarinShapeMappingRule {
  id              String               @id @default(cuid())
  mappingSetId    String
  mappingSet      SarinShapeMappingSet @relation(fields: [mappingSetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// upper(trim(raw shape)).
  rawShapeKey     String
  /// The raw shape exactly as the authoritative master spells it.
  sourceRawShape  String
  normalizedShape String
  /// NONE | RATIO_RANGE.
  conditionKind   String
  /// Inclusive bounds; NULL means unbounded on that side. Both NULL only when NONE.
  ratioMin        Decimal?             @db.Decimal(6, 3)
  ratioMax        Decimal?             @db.Decimal(6, 3)
  /// Why the rule exists. Not part of the set's content identity.
  note            String?
  createdAt       DateTime             @default(now())
  /// When and by whom this mapping was last changed. Carried forward unchanged into each
  /// newer snapshot; NULL for mappings that predate change tracking.
  changedAt       DateTime?
  changedByUserId String?

  interpretations SarinRowInterpretation[]
  planPieces      SarinPlanPiece[]

  @@index([mappingSetId, rawShapeKey])
}

/// One validation attempt of one batch, bound to exactly one APPROVED mapping set.
/// Append-only history: a row is written RUNNING when a worker claims the batch and is
/// finalized once — COMPLETED with a result, FAILED, or ABANDONED when its lease expired.
model SarinValidationAttempt {
  id                    String               @id @default(cuid())
  batchId               String
  batch                 SarinImportBatch     @relation(fields: [batchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Equals the batch's validationAttempt when the attempt started.
  attemptNumber         Int
  shapeMappingSetId     String
  shapeMappingSet       SarinShapeMappingSet @relation(fields: [shapeMappingSetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  startedByUserId       String
  /// The batch fencing version the claim was issued with.
  claimFencingVersion   Int
  /// The validation contract this attempt ran. A completed attempt proves only the checks
  /// of its own profile, so reuse and output generation require the current profile.
  validationProfileVersion String
  /// RUNNING | COMPLETED | FAILED | ABANDONED.
  status                String               @default("RUNNING")
  /// VALIDATED | NEEDS_REVIEW, exactly when COMPLETED.
  result                String?
  /// Safe diagnostic code, exactly when FAILED or ABANDONED.
  failureCode           String?
  startedAt             DateTime             @default(now())
  finishedAt            DateTime?
  blockCount            Int?
  parsedBlockCount      Int?
  quarantinedBlockCount Int?
  interpretationCount   Int?
  issueCount            Int?
  blockingIssueCount    Int?

  interpretations SarinRowInterpretation[]
  outputVersions  SarinOutputVersion[]

  @@unique([batchId, attemptNumber])
  @@unique([id, batchId])
  @@index([batchId, status])
  @@index([shapeMappingSetId, status])
}

/// How one source row was interpreted by one validation attempt. The immutable source row
/// is never copied or changed; this records only the derived shape resolution and its
/// lineage. Insert-only, one per row per attempt.
model SarinRowInterpretation {
  id                String                 @id @default(cuid())
  batchId           String
  attemptId         String
  attempt           SarinValidationAttempt @relation(fields: [attemptId, batchId], references: [id, batchId], onDelete: Restrict, onUpdate: Restrict)
  validationAttempt Int
  sourceRowNumber   Int
  sourceRow         SarinSourceRow         @relation(fields: [batchId, sourceRowNumber], references: [batchId, sourceRowNumber], onDelete: Restrict, onUpdate: Restrict)
  stoneBlockId      String
  stoneBlock        SarinStoneBlock        @relation(fields: [stoneBlockId, batchId], references: [id, batchId], onDelete: Restrict, onUpdate: Restrict)
  shapeMappingSetId String
  shapeMappingSet   SarinShapeMappingSet   @relation(fields: [shapeMappingSetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// upper(trim(raw shape)); NULL when the row has no shape.
  rawShapeKey       String?
  normalizedShape   String?
  mappingRuleId     String?
  mappingRule       SarinShapeMappingRule? @relation(fields: [mappingRuleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// MAPPED | CONDITIONALLY_MAPPED | UNMAPPED | AMBIGUOUS | OVERRIDDEN.
  mappingResult     String
  /// Bounded JSON object of safe facts, e.g. the Ratio a conditional rule was evaluated at.
  metadataJson      String?
  createdAt         DateTime               @default(now())

  @@unique([batchId, validationAttempt, sourceRowNumber])
  @@index([attemptId, mappingResult])
  @@index([stoneBlockId])
}

/// One immutable structured output of a validated batch. Everything in it is derived on
/// the server from persisted, validated evidence; its inputs hash identifies exactly which
/// evidence and which rule versions produced it. Only the lifecycle status may change
/// (GENERATED -> SUPERSEDED); the content never does.
model SarinOutputVersion {
  id                       String                 @id @default(cuid())
  batchId                  String
  batch                    SarinImportBatch       @relation(fields: [batchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  validationAttemptId      String
  validationAttempt        SarinValidationAttempt @relation(fields: [validationAttemptId, batchId], references: [id, batchId], onDelete: Restrict, onUpdate: Restrict)
  shapeMappingSetId        String
  shapeMappingSet          SarinShapeMappingSet   @relation(fields: [shapeMappingSetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  validationProfileVersion String
  transformProfileVersion  String
  /// SHA-256 of the transformation profile definition.
  transformProfileHash     String
  versionNumber            Int
  /// SHA-256 over the source file, contract, validation attempt, mapping set content,
  /// validation profile and transformation profile.
  inputsHash               String
  packetType               String
  /// GENERATED | SUPERSEDED. Approval arrives in a later phase.
  status                   String                 @default("GENERATED")
  generatedByUserId        String
  generatedAt              DateTime               @default(now())
  supersededAt             DateTime?
  /// The version this one replaced as the batch's current output.
  supersedesVersionId      String?                @unique
  supersedes               SarinOutputVersion?    @relation("SarinOutputSupersession", fields: [supersedesVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supersededBy             SarinOutputVersion?    @relation("SarinOutputSupersession")
  stoneCount               Int
  optionCount              Int
  pieceCount               Int

  options                  SarinPlanOption[]
  pieces                   SarinPlanPiece[]

  @@unique([batchId, versionNumber])
  @@unique([batchId, inputsHash])
  @@unique([id, batchId])
  @@index([batchId, status])
}

/// One plan option of one stone: a MAIN individual plan or an ADDITIONAL group. Insert-only.
/// Yield is stored as its exact numerator and denominator plus a fixed-precision result.
model SarinPlanOption {
  id                     String             @id @default(cuid())
  outputVersionId        String
  batchId                String
  outputVersion          SarinOutputVersion @relation(fields: [outputVersionId, batchId], references: [id, batchId], onDelete: Restrict, onUpdate: Restrict)
  stoneBlockId           String
  stoneBlock             SarinStoneBlock    @relation(fields: [stoneBlockId, batchId], references: [id, batchId], onDelete: Restrict, onUpdate: Restrict)
  /// 1..n within the stone, in output order.
  optionSequence         Int
  /// Blue/White: MAIN | ADDITIONAL. Pink: MK (Makeable) | SL (Solace) | BP (Best Pair) |
  /// BT (Best Twin), derived from the physical record positions. Checked against the
  /// version's packet type by the database.
  optionKind             String
  mainOrdinal            Int?
  additionalGroupOrdinal Int?
  pieceCount             Int
  totalEstimatedWeight   Decimal            @db.Decimal(12, 3)
  yieldNumerator         Decimal            @db.Decimal(12, 3)
  yieldDenominator       Decimal            @db.Decimal(12, 3)
  /// Percentage to ten decimal places, rounded half-up. Ranking can also compare the exact
  /// numerator and denominator.
  yieldPercent           Decimal            @db.Decimal(24, 10)
  firstOutputRow         Int
  lastOutputRow          Int
  /// BT only: the absolute Estimated Weight difference of the two twins. No tolerance is
  /// confirmed, so a non-zero value is an advisory, never a rejection.
  pairWeightDifference   Decimal?           @db.Decimal(12, 3)
  createdAt              DateTime           @default(now())

  pieces                 SarinPlanPiece[]

  @@unique([outputVersionId, stoneBlockId, optionSequence])
  @@unique([id, outputVersionId])
  @@index([outputVersionId, stoneBlockId])
  @@index([outputVersionId, firstOutputRow])
}

/// One output row: a source row placed in a plan option. Insert-only. Raw Length and Width
/// are stored as read; the export decides their column order.
model SarinPlanPiece {
  id                String             @id @default(cuid())
  outputVersionId   String
  outputVersion     SarinOutputVersion @relation(fields: [outputVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  planOptionId      String
  planOption        SarinPlanOption    @relation(fields: [planOptionId, outputVersionId], references: [id, outputVersionId], onDelete: Restrict, onUpdate: Restrict)
  pieceSequence     Int
  batchId           String
  sourceRowId       String
  sourceRow         SarinSourceRow     @relation(fields: [sourceRowId, batchId], references: [id, batchId], onDelete: Restrict, onUpdate: Restrict)
  sourceRowNumber   Int
  /// 1..N across the whole output version, in output order.
  outputRowSequence Int
  rawShape          String
  /// MAPPED: normalizedShape and mappingRuleId come from the version's mapping set.
  /// RAW_PASSTHROUGH: the set has no rule for the shape (design v1.7 §15.10); both stay
  /// NULL and the output shows rawShape. Enforced by CHECK and the insert guard.
  shapeResolution   String             @default("MAPPED")
  normalizedShape   String?
  mappingRuleId     String?
  mappingRule       SarinShapeMappingRule? @relation(fields: [mappingRuleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  estimatedWeight   Decimal            @db.Decimal(12, 3)
  clarity           String
  color             String
  depthPct          Decimal            @db.Decimal(9, 3)
  ratio             Decimal            @db.Decimal(9, 3)
  length            Decimal            @db.Decimal(9, 3)
  width             Decimal            @db.Decimal(9, 3)
  depthMm           Decimal            @db.Decimal(9, 3)
  createdAt         DateTime           @default(now())

  @@unique([outputVersionId, sourceRowId])
  @@unique([outputVersionId, outputRowSequence])
  @@unique([planOptionId, pieceSequence])
  @@index([planOptionId])
}

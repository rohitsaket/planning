model LotMasterRecord {
  id                  String    @id @default(cuid())
  lotId               String    @unique
  sourceRecordId      String?
  sourceType          String    @default("FIXTURE")
  entityType          String    @default("POLISHED")
  currentStatus       String
  previousStatus      String?
  statusEffectiveDate DateTime
  docDate             DateTime
  quantity            Decimal   @default(1)
  /// How this quantity was established. Null on rows written before provenance was
  /// recorded, which `resolveCanonicalQuantity` reports as LEGACY_DEFAULT_AMBIGUOUS
  /// rather than treating the column default of 1 as a supplied value.
  quantityProvenance  String?
  /// Pieces that may enter an authoritative total. Null whenever the provenance is not
  /// countable — deliberately nullable so "no confirmed pieces" is distinguishable from
  /// a confirmed zero.
  confirmedPieces     Int?
  shape               String
  shapeNormalized     String?
  weight              Decimal
  color               String?
  clarity             String?
  labRaw              String?
  labNormalized       String?
  certificate         String?
  treatment           String?
  saleTotalUsd        Decimal?
  customerId          String?
  customerCode        String?
  customerName        String?
  departmentId        String?
  departmentName      String?
  locationId          String?
  locationName        String?
  country             String
  branch              String
  roughOrPolished     String    @default("POLISHED")
  wipStage            String?
  parentRoughId       String?
  kapan               String?
  stoneName           String?
  /// --- Canonical classification (Master Phase 1) ---------------------------
  /// Written by the central classifier, never by a downstream service. Nullable because
  /// rows projected before this existed carry no classification; a null is treated as
  /// unclassified and therefore unavailable, not as a permissive default.
  holdState                    String?
  canonicalLifecycle           String?
  inventoryClass               String?
  classificationAvailable      Boolean?
  classificationPlanningEligible Boolean?
  classificationReviewRequired Boolean?
  classificationTerminal       Boolean?
  /// Comma-separated fixed reason codes. Never free text, never a source value.
  classificationReasons        String?
  /// Profile and version that produced this classification, so it stays reproducible
  /// after the mapping is later edited.
  classificationProfile        String?
  classificationProfileVersion Int?
  classificationState          String?

  /// --- Canonical category classification (Lab | Shape | Weight Band) --------
  /// Decided once at projection time by classifyCanonicalCategory and consumed by the
  /// demand calculation, so a committed run cannot be re-categorised later by editing a
  /// mapping row. An unapproved dimension leaves its normalized column null and records
  /// the reason here rather than storing the raw value as though it were normalized.
  categoryLabState             String?
  categoryShapeState           String?
  categoryWeightBandState      String?
  /// APPROVED only when all three dimensions are approved; otherwise REVIEW_REQUIRED.
  categoryState                String?
  /// "Lab|Shape|Band". Null unless the category is fully approved.
  categoryKey                  String?
  /// Comma-separated fixed reason codes. Never a formula or a mapping-table dump.
  categoryReviewReasons        String?
  weightBandId                 String?
  weightBandLabel              String?
  isCurrent           Boolean   @default(true)
  removalReason       String?
  removedFromLiveAt   DateTime?
  firstSeenAt         DateTime  @default(now())
  lastSeenAt          DateTime  @default(now())

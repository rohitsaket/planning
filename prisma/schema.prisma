generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Group {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  createdAt DateTime   @default(now())
  companies Company[]
}

model Company {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  groupId   String
  group     Group      @relation(fields: [groupId], references: [id])
  countries Country[]
  createdAt DateTime   @default(now())
}

model Country {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  branches    Branch[]
  createdAt   DateTime  @default(now())
}

model Branch {
  id         String    @id @default(cuid())
  code       String    @unique
  name       String
  countryId  String
  country    Country   @relation(fields: [countryId], references: [id])
  offices    Office[]
  createdAt  DateTime  @default(now())
}

model Office {
  id         String    @id @default(cuid())
  code       String    @unique
  name       String
  branchId   String
  branch     Branch    @relation(fields: [branchId], references: [id])
  createdAt  DateTime  @default(now())
}

model FantasyDepartment {
  id            String   @id @default(cuid())
  fantasyDeptId String   @unique
  name          String
  country       String
  branch        String
  type          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  locations     FantasyLocation[]
}

model FantasyLocation {
  id             String   @id @default(cuid())
  fantasyLocId   String   @unique
  name           String
  departmentId   String?
  department     FantasyDepartment? @relation(fields: [departmentId], references: [id])
  country        String
  branch         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model FantasyStatusMapping {
  id              String   @id @default(cuid())
  fantasyStatus   String   @unique
  planningClass   String
  countsAvailable Boolean  @default(false)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Customer {
  id              String   @id @default(cuid())
  customerCode    String   @unique
  name            String
  country         String
  branch          String
  accountOwner    String?
  businessPriority String?
  priorityReason  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  salesRecords    SalesRecord[]
  memoRecords     MemoRecord[]
  salesOrders     SalesOrder[]

  @@index([country, branch])
  @@index([name])
}

model SalesRecord {
  id            String   @id @default(cuid())
  lotId         String   @unique
  docDate       DateTime
  lotStatusDb   String
  qty           Decimal  @default(1)
  shape         String
  weight        Decimal
  weightBandId  String?
  weightBand    WeightBand? @relation(fields: [weightBandId], references: [id])
  color         String?
  clarity       String?
  labRaw        String?
  labNormalized String?
  certificate   String?
  treatment     String?
  saleTotalUsd  Decimal?
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  country       String
  branch        String
  salesperson   String?
  createdAt     DateTime @default(now())

  @@index([customerId, lotStatusDb, docDate])
  @@index([lotStatusDb, docDate])
  @@index([country, branch])
}

model MemoRecord {
  id            String   @id @default(cuid())
  lotId         String   @unique
  memoDate      DateTime
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  country       String
  branch        String
  shape         String
  weight        Decimal
  labNormalized String?
  color         String?
  clarity       String?
  treatment     String?
  memoValueUsd  Decimal?
  status        String   @default("OPEN")
  memoAgeDays   Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([customerId, status])
  @@index([country, branch, status])
  @@index([memoDate])
}

model SalesOrder {
  id            String   @id @default(cuid())
  orderNumber   String   @unique
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  orderDate     DateTime
  requiredDate  DateTime?
  promisedDate  DateTime?
  branch        String
  country       String
  status        String   @default("OPEN")
  priority      String   @default("NORMAL")
  priorityReason String?
  notes         String?
  lines         SalesOrderLine[]
  createdAt     DateTime @default(now())

  @@index([customerId, status])
  @@index([country, branch, status])
  @@index([orderDate])
}

model SalesOrderLine {
  id             String   @id @default(cuid())
  orderId        String
  order          SalesOrder @relation(fields: [orderId], references: [id])
  lineNo         Int
  lab            String?
  shape          String
  weight         Decimal?
  weightBandId   String?
  weightBand     WeightBand? @relation(fields: [weightBandId], references: [id])
  color          String?
  clarity        String?
  treatment      String?
  qtyOrdered     Int
  qtyAllocated   Int      @default(0)
  qtyDelivered   Int      @default(0)
  qtyOutstanding Int      @default(0)
  backorderQty   Int      @default(0)
  specialRequirement String?
  createdAt      DateTime @default(now())
}

model PolishedStone {
  id                  String   @id @default(cuid())
  fantasyLotId       String   @unique
  fantasyDepartmentId String?
  fantasyLocationId  String?
  country            String
  branch             String
  fantasyStatus      String
  labRaw             String?
  labNormalized      String?
  shape              String
  shapeNormalized    String?
  weight             Decimal
  weightBandId       String?
  weightBand         WeightBand? @relation(fields: [weightBandId], references: [id])
  color              String?
  clarity            String?
  certificate        String?
  treatment          String?
  planningClass      String   @default("PHYSICAL")
  lastUpdated        DateTime @default(now())
  createdAt          DateTime @default(now())

  @@index([country, branch])
  @@index([planningClass])
  @@index([labNormalized])
  @@index([lastUpdated])
}

model RoughStone {
  id                  String   @id @default(cuid())
  fantasyRoughId     String   @unique
  kapan              String
  packet              String
  stoneName           String
  signer              String?
  /// The packet the stone is kept in: WHITE | BLUE. All stones are white diamonds.
  packetType          String   @default("WHITE")
  roughWeight         Decimal
  country             String
  branch              String
  fantasyDepartmentId String?
  fantasyLocationId  String?
  fantasyStatus       String
  planningEligible    Boolean  @default(true)
  planningStatus      String   @default("AVAILABLE")
  parentRoughId      String?
  lastMovement        DateTime?
  lastUpdated        DateTime @default(now())
  createdAt          DateTime @default(now())

  planningCases      PlanningCase[]
  reservations       RoughReservation[]
}

model RoughReservation {
  id            String   @id @default(cuid())
  roughId       String
  rough         RoughStone @relation(fields: [roughId], references: [id])
  planningCaseId String?
  planningCase  PlanningCase? @relation(fields: [planningCaseId], references: [id])
  status        String   @default("SOFT_RESERVED")
  reservedBy    String
  reservedAt    DateTime @default(now())
  releasedAt    DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  activeRoughKey String?  @unique
  reservedByUserId String?
}

model WeightBand {
  id         String    @id @default(cuid())
  code       String    @unique
  label      String
  minCt      Decimal
  maxCt      Decimal
  sortOrder  Int
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())

  salesRecords      SalesRecord[]
  polishedStones    PolishedStone[]
  salesOrderLines   SalesOrderLine[]
  requirements      Requirement[]
  planningCategories PlanningCategory[]
}

model LabMapping {
  id            String   @id @default(cuid())
  rawLab        String   @unique
  normalizedLab String
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model ShapeMapping {
  id               String   @id @default(cuid())
  rawShape         String   @unique
  normalizedShape  String
  category         String?
  active           Boolean  @default(true)
  createdAt        DateTime  @default(now())
}

model PlanningCategory {
  id            String   @id @default(cuid())
  code          String   @unique
  labNormalized String
  shape         String
  weightBandId  String
  weightBand    WeightBand @relation(fields: [weightBandId], references: [id])
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model DemandCalculationLock {
  id               String    @id @default("DEMAND_CALCULATION")
  isLocked         Boolean   @default(false)
  lockToken        String?
  lockedAt         DateTime?
  lockedBy         String?
  lockedByUserId   String?
  runId            String?
  previousOwner    String?
  previousRunId    String?
  previousLockedAt DateTime?
  unlockReason     String?
  unlockedBy       String?
  unlockedAt       DateTime?
  updatedAt        DateTime  @updatedAt
}

model DemandRun {
  id                 String                  @id @default(cuid())
  runDate            DateTime                @default(now())
  windowDays         Int                     @default(90)
  ruleVersion        String                  @default("DEMAND-V1")
  status             String                  @default("COMPLETED")
  sourcePolicy       String                  @default("CANONICAL_FANTASY")
  totalShortage      Int                     @default(0)
  totalExcess        Int                     @default(0)
  startedAt          DateTime                @default(now())
  finishedAt         DateTime?
  businessDateIst    String?
  lookbackStart      DateTime?
  lookbackEnd        DateTime?
  mappingVersion     String?
  mappingFingerprint String?
  wipPolicyStatus    String                  @default("NOT_CONFIGURED")
  wipRuleVersion     String?
  wipEligibleStages  String?
  lockToken          String?
  sourceMode         String                  @default("FIXTURE")
  isSimulated        Boolean                 @default(true)
  checkpoint         Int                     @default(0)
  lastBatchId        String?
  /// The IntegrationSyncRun this calculation was bound to. Deliberately not a foreign
  /// key: demand history is permanent operational record and must survive whatever
  /// retention is later applied to synchronization runs. Null on runs recorded before
  /// binding existed, which read as "source identity unavailable" rather than being
  /// backfilled with a guess.
  sourceSyncRunId    String?
  sourceCutoff       DateTime?
  salesCount         Int                     @default(0)
  inventoryCount     Int                     @default(0)
  wipCount           Int                     @default(0)
  planCount          Int                     @default(0)
  excludedCount      Int                     @default(0)
  actor              String?
  actorUserId        String?
  errorSummary       String?
  durationMs         Int                     @default(0)
  createdAt          DateTime                @default(now())

  metrics            DemandMetric[]
  traceItems         DemandMetricTraceItem[]

  @@index([runDate])
  @@index([status])
}

model DemandMetric {
  id                   String     @id @default(cuid())
  runId                String
  run                  DemandRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  planningCategory     String
  labNormalized        String?
  shapeNormalized      String?
  weightBandCode       String?
  weightBandLabel      String?
  sales90d             Int
  monthlyAverage       Decimal
  unroundedTarget      Decimal
  roundedTarget        Int
  availableStock       Int
  memoQty              Int        @default(0)
  reservedQty          Int        @default(0)
  blockedQty           Int        @default(0)
  physicalShortage     Int
  excessStock          Int
  wipCoverage          Int        @default(0)
  unallocatedWip       Int        @default(0)
  pipelineNeed         Int
  approvedPlanCoverage Int        @default(0)
  remainingUnplanned   Int
  forecastSignal       Int        @default(0)
  status               String     @default("COMPLETED")
  traceJson            String?
  createdAt            DateTime   @default(now())

  @@index([runId])
  @@index([planningCategory])
  @@index([runId, physicalShortage])
  @@index([runId, planningCategory])
}

model DemandMetricTraceItem {
  id               String     @id @default(cuid())
  runId            String
  run              DemandRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  demandMetricId   String?
  planningCategory String
  traceType        String
  lotId            String?
  sourceRecordId   String?
  eventKey         String?
  quantity         Decimal    @default(1)
  /// Provenance of the quantity on this trace row, carried so an excluded record stays
  /// explainable without re-deriving the decision.
  quantityProvenance String?
  weight           Decimal?
  lab              String?
  shape            String?
  weightBand       String?
  wipStage         String?
  customerName     String?
  saleTotalUsd     Decimal?
  docDate          DateTime?
  reason           String?
  isIncluded       Boolean    @default(true)
  checkpoint       Int?
  batchId          String?
  metadataJson     String?
  createdAt        DateTime   @default(now())

  @@index([runId, planningCategory])
  @@index([runId, traceType])
  @@index([lotId])
  @@index([eventKey])
}

model Requirement {
  id                  String   @id @default(cuid())
  requirementCode     String   @unique
  type                String
  status              String   @default("ACTIVE")
  customerId          String?
  customerName        String?
  salesOrderId        String?
  orderNumber         String?
  groupCode           String
  companyCode         String
  country             String
  branch              String
  labNormalized       String?
  shape               String?
  weightBandId        String?
  weightBand          WeightBand? @relation(fields: [weightBandId], references: [id])
  colorGroup          String?
  clarityGroup        String?
  treatment           String?
  requiredQty         Int
  physicalStockQty    Int      @default(0)
  planningAvailableQty Int     @default(0)
  memoQty             Int      @default(0)
  transferCoverage    Int      @default(0)
  wipCoverage         Int      @default(0)
  approvedPlanCoverage Int     @default(0)
  actualCoverage      Int      @default(0)
  remainingUnplanned  Int      @default(0)
  forecastQty         Int      @default(0)
  requiredBy          DateTime?
  createdDate         DateTime @default(now())
  ageDays             Int      @default(0)
  daysRemaining       Int?
  daysOverdue         Int?
  customerPriority    String?
  orderPriority       String?
  requirementPriority String?
  priorityReason      String?
  calculationRunId   String?
  businessRuleVersion String?
  sourceRecords       String?
  createdBy           String?
  updatedBy           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  allocations         RequirementAllocation[]

  @@index([country, branch])
  @@index([status])
  @@index([labNormalized, shape, weightBandId])
}

model RequirementAllocation {
  id            String   @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id])
  plannedPieceId String?
  planOptionId  String?
  planOption    PlanOption? @relation(fields: [planOptionId], references: [id])
  allocatedQty  Int
  allocatedBy   String
  allocatedAt   DateTime @default(now())
  status        String   @default("ALLOCATED")
  createdAt     DateTime @default(now())
}

model PlanningCase {
  id              String   @id @default(cuid())
  caseCode        String   @unique
  roughId         String
  rough           RoughStone @relation(fields: [roughId], references: [id])
  stoneName       String
  kapan           String
  packet          String
  originalRoughWeight Decimal
  packetType      String   @default("WHITE")
  planner         String
  planningDate    DateTime @default(now())
  status          String   @default("DRAFT")
  currentVersion  Int      @default(1)
  requirementContext String?
  sourceFile      String?
  selectedOptionId String?
  approvedBy      String?
  approvedAt      DateTime?
  approvalComment String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  versions        PlanVersion[]
  reservations    RoughReservation[]
}

model PlanVersion {
  id              String   @id @default(cuid())
  planningCaseId  String
  planningCase    PlanningCase @relation(fields: [planningCaseId], references: [id])
  versionNumber   Int
  previousVersionId String?
  reason          String?
  status          String   @default("DRAFT")
  createdBy       String
  createdAt       DateTime @default(now())
  supersededAt    DateTime?
  options         PlanOption[]

  @@unique([planningCaseId, versionNumber])
}

model PlanOption {
  id                String   @id @default(cuid())
  optionCode       String   @unique
  versionId        String
  version          PlanVersion @relation(fields: [versionId], references: [id])
  optionNumber     Int
  expectedPieces   Int
  expectedTotalWeight Decimal
  yieldPct         Decimal
  matchingRequiredPieces Int @default(0)
  requirementCoverage Int   @default(0)
  coveragePct      Decimal  @default(0)
  nonRequiredPieces Int    @default(0)
  expectedColor    String?
  expectedClarity  String?
  certificationIntent String?
  potentialExcess  Int      @default(0)
  validationWarnings String?
  selected         Boolean  @default(false)
  selectedBy       String?
  selectedAt       DateTime?
  approvalStatus   String   @default("DRAFT")
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime @default(now())

  pieces           PlanOptionPiece[]
  allocations      RequirementAllocation[]
  reconciliations PlanActualReconciliation[]
}

model PlanOptionPiece {
  id                String   @id @default(cuid())
  pieceCode        String   @unique
  planOptionId     String
  planOption        PlanOption @relation(fields: [planOptionId], references: [id])
  sequence         Int
  expectedShape    String
  expectedWeight   Decimal
  expectedColor    String?
  expectedClarity  String?
  expectedCategory String?
  requirementAllocationId String?
  certificationIntent String?
  fantasyChildId   String?
  actualPolishedLotId String?
  actualShape      String?
  actualWeight     Decimal?
  actualCategory   String?
  fulfilled        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ActualPolishedLink {
  id             String   @id @default(cuid())
  plannedPieceId String?
  fantasyPolishedLotId String
  actualShape     String
  actualWeight    Decimal
  actualCategory  String?
  actualYieldPct  Decimal?
  linkedAt        DateTime @default(now())
}

model PlanActualReconciliation {
  id                 String   @id @default(cuid())
  planOptionId       String
  planOption         PlanOption? @relation(fields: [planOptionId], references: [id])
  expectedPieces     Int
  actualPieces       Int      @default(0)
  expectedTotalWeight Decimal
  actualTotalWeight  Decimal  @default(0)
  plannedYieldPct    Decimal
  actualYieldPct     Decimal  @default(0)
  yieldVariance      Decimal  @default(0)
  expectedCoverage   Int
  actualCoverage     Int      @default(0)
  coverageVariance   Int      @default(0)
  status             String   @default("OPEN")
  reconciledAt       DateTime?
  createdAt          DateTime @default(now())
}

model ForecastRun {
  id           String   @id @default(cuid())
  modelVersion String
  runDate      DateTime @default(now())
  horizon30d   Int
  horizon60d   Int
  horizon90d   Int
  metricsJson  String?
  status       String  @default("COMPLETED")
  createdAt    DateTime @default(now())
  predictions  ForecastPrediction[]
}

model ForecastPrediction {
  id            String   @id @default(cuid())
  runId         String
  run           ForecastRun @relation(fields: [runId], references: [id])
  category      String
  prediction30d Int
  prediction60d Int
  prediction90d Int
  confidence    Decimal
  trend         String
  stockoutRisk  String?
  stockoutDate  DateTime?
  createdAt     DateTime @default(now())
}

model ModelVersion {
  id              String   @id @default(cuid())
  modelName       String   @unique
  version         String
  algorithm       String
  trainingPeriod  String
  validationPeriod String?
  metricsJson     String?
  publishedBy     String?
  publishedAt     DateTime?
  status          String   @default("DRAFT")
  createdAt       DateTime @default(now())
}

model BusinessRule {
  id            String   @id @default(cuid())
  ruleId        String   @unique
  domain        String
  name          String
  version       String
  effectiveDate DateTime
  status        String   @default("PROPOSED")
  configuration String?
  approvedBy    String?
  approvedAt    DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model FeatureFlag {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  enabled     Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  entity    String
  entityId  String?
  before    String?
  after     String?
  reason    String?
  timestamp DateTime @default(now())
  correlationId String?
  actorUserId String?
  actorRole   String?
  requestId   String?
  sessionId   String?
  sourceIp    String?
  /// SUCCESS | DENIED | FAILED. Absent on rows written before this field existed.
  outcome     String?
  /// SECURITY | OPERATIONAL.
  category    String?

  @@index([timestamp])
  @@index([actorUserId])
  @@index([entity, entityId, timestamp])
  @@index([category, timestamp])
}

model DataQualityIssue {
  id               String    @id @default(cuid())
  issueCode        String    @unique
  source           String
  entity           String
  recordId         String?
  rule             String
  message          String
  severity         String
  status           String   @default("OPEN")
  syncRunId        String?
  batchId          String?
  checkpoint       Int?
  affectedField    String?
  rawValue         String?
  normalizedValue  String?
  downstreamImpact String?
  detectedAt       DateTime @default(now())
  assignedTo       String?
  resolution       String?
  resolvedBy       String?
  resolvedAt       DateTime?

  @@index([source, status])
  @@index([batchId])
  @@index([rule])
  @@index([recordId])
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  title     String
  message   String
  severity  String   @default("INFO")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model IntegrationSyncRun {
  id                     String    @id @default(cuid())
  source                 String
  entity                 String
  status                 String
  sourceMode             String    @default("FIXTURE")
  isSimulated            Boolean   @default(true)
  batchId                String?
  startingCheckpoint     Int       @default(0)
  endingCheckpoint       Int       @default(0)
  sourceCutoff           DateTime?
  recordsReceived        Int       @default(0)
  recordsCreated         Int       @default(0)
  recordsUpdated         Int       @default(0)
  recordsUnchanged       Int       @default(0)
  recordsSkipped         Int       @default(0)
  recordsRejected        Int       @default(0)
  recordsRemoved         Int       @default(0)
  historyVersionsCreated Int       @default(0)
  dqIssuesCreated        Int       @default(0)
  recordsFetched         Int       @default(0)
  errorsJson             String?
  errorSummary           String?
  durationMs             Int       @default(0)
  triggeredBy            String?
  triggeredByUserId      String?
  startedAt              DateTime  @default(now())
  finishedAt             DateTime?
  nextRunAt              DateTime?

  @@index([startedAt])
  @@index([status])
  @@index([batchId])
}

/// Mutual exclusion over the canonical Fantasy records themselves.
///
/// The sync lock and the demand lock each guard their own operation; neither knew about
/// the other, so a synchronization could commit a batch while a demand calculation was
/// part-way through reading the rows it was changing. This row is the one thing both
/// must claim, so those two operations can never overlap.
///
/// A singleton: one canonical state, one claim.
model CanonicalStateClaim {
  id            String    @id @default("FANTASY_CANONICAL_STATE")
  /// SYNC | DEMAND | null when free.
  holder        String?
  /// Unique per claim. A release must present it, so no operation can clear another's.
  ownerToken    String?
  /// Actor recorded for audit. Never accepted from a request body.
  claimedBy     String?
  claimedAt     DateTime?
  /// When the claim stops being honoured, so a crashed worker cannot hold it forever.
  expiresAt     DateTime?
  /// Monotonic. Incremented on every claim and every forced release, so a worker whose
  /// claim was broken cannot finalize afterwards even if it still holds its own token.
  fencingVersion Int      @default(0)
  /// Set by a forced release so the displaced worker can see why it was fenced.
  lastForcedBy  String?
  lastForcedAt  DateTime?
  updatedAt     DateTime  @updatedAt
}

model IntegrationApiToken {
  id          String   @id @default(cuid())
  source      String   @unique
  tokenEnc    String
  tokenType   String   @default("bearer")
  issuedTo    String?
  issuedAt    DateTime @default(now())
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt
}

model FantasyLiveLot {
  id                            String    @id @default(cuid())
  sourceRecordKey               String    @unique

  metalId                       String?
  metalWeight                   Decimal?  @db.Decimal(18, 6)
  previousDepartmentAccountName String?
  processName                   String?
  remark                        String?
  qty                           Decimal?  @db.Decimal(18, 6)
  lotId                         String?
  lotName                       String?
  onHold                        Boolean?
  lotStatusDb                   String?
  shape                         String?
  color                         String?
  clarity                       String?
  size                          String?
  weight                        Decimal?  @db.Decimal(18, 6)
  labName                       String?

// ============================================================================
// DIAMOND MANUFACTURING — ANALYSIS, REQUIREMENT, PLANNING & TRACEABILITY
// Prisma schema (SQLite). Decimal-safe where weight/currency precision matters.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ORGANIZATION HIERARCHY
// ---------------------------------------------------------------------------
model Group {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  createdAt DateTime   @default(now())
  companies Company[]
}

model Company {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  groupId   String
  group     Group      @relation(fields: [groupId], references: [id])
  countries Country[]
  createdAt DateTime   @default(now())
}

model Country {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  branches    Branch[]
  createdAt   DateTime  @default(now())
}

model Branch {
  id         String    @id @default(cuid())
  code       String    @unique
  name       String
  countryId  String
  country    Country   @relation(fields: [countryId], references: [id])
  offices    Office[]
  createdAt  DateTime  @default(now())
}

model Office {
  id         String    @id @default(cuid())
  code       String    @unique
  name       String
  branchId   String
  branch     Branch    @relation(fields: [branchId], references: [id])
  createdAt  DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// FANTASY ERP — authoritative source-of-truth entities
// ---------------------------------------------------------------------------
model FantasyDepartment {
  id            String   @id @default(cuid())
  fantasyDeptId String   @unique
  name          String
  country       String
  branch        String
  type          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  locations     FantasyLocation[]
}

model FantasyLocation {
  id             String   @id @default(cuid())
  fantasyLocId   String   @unique
  name           String
  departmentId   String?
  department     FantasyDepartment? @relation(fields: [departmentId], references: [id])
  country        String
  branch         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model FantasyStatusMapping {
  id              String   @id @default(cuid())
  fantasyStatus   String   @unique
  planningClass   String   // PHYSICAL | PLANNING_AVAILABLE | RESERVED | HOLD | TRANSFER | MEMO | OTHER
  countsAvailable Boolean  @default(false)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// CUSTOMERS & SALES
// ---------------------------------------------------------------------------
model Customer {
  id              String   @id @default(cuid())
  customerCode    String   @unique
  name            String
  country         String
  branch          String
  accountOwner    String?
  businessPriority String? // Strategic | Key | Standard | New | Internal
  priorityReason  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  salesRecords    SalesRecord[]
  memoRecords     MemoRecord[]
  salesOrders     SalesOrder[]
}

model SalesRecord {
  id            String   @id @default(cuid())
  lotId         String   @unique
  docDate       DateTime
  lotStatusDb   String   // Invoice | Memo | Stock
  qty           Decimal  @default(1)
  shape         String
  weight        Decimal
  weightBandId  String?
  weightBand    WeightBand? @relation(fields: [weightBandId], references: [id])
  color         String?
  clarity       String?
  labRaw        String?
  labNormalized String?
  certificate   String?
  treatment     String? // HPHT | CVD | NULL
  saleTotalUsd  Decimal?
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  country       String
  branch        String
  salesperson   String?
  createdAt     DateTime @default(now())
}

model MemoRecord {
  id            String   @id @default(cuid())
  lotId         String   @unique
  memoDate      DateTime
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  country       String
  branch        String
  shape         String
  weight        Decimal
  labNormalized String?
  color         String?
  clarity       String?
  treatment     String?
  memoValueUsd  Decimal?
  status        String   @default("OPEN") // OPEN | RETURNED | INVOICED
  memoAgeDays   Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SalesOrder {
  id            String   @id @default(cuid())
  orderNumber   String   @unique
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  orderDate     DateTime
  requiredDate  DateTime?
  promisedDate  DateTime?
  branch        String
  country       String
  status        String   @default("OPEN") // OPEN | PARTIAL | FULFILLED | CANCELLED
  priority      String   @default("NORMAL") // CRITICAL | HIGH | NORMAL | LOW | WATCH
  priorityReason String?
  notes         String?
  lines         SalesOrderLine[]
  createdAt     DateTime @default(now())
}

model SalesOrderLine {
  id             String   @id @default(cuid())
  orderId        String
  order          SalesOrder @relation(fields: [orderId], references: [id])
  lineNo         Int
  lab            String?
  shape          String
  weight         Decimal?
  weightBandId   String?
  weightBand     WeightBand? @relation(fields: [weightBandId], references: [id])
  color          String?
  clarity        String?
  treatment      String?
  qtyOrdered     Int
  qtyAllocated   Int      @default(0)
  qtyDelivered   Int      @default(0)
  qtyOutstanding Int      @default(0)
  backorderQty   Int      @default(0)
  specialRequirement String?
  createdAt      DateTime @default(now())
}

// ---------------------------------------------------------------------------
// POLISHED & ROUGH INVENTORY (Fantasy authoritative)
// ---------------------------------------------------------------------------
model PolishedStone {
  id                  String   @id @default(cuid())
  fantasyLotId       String   @unique
  fantasyDepartmentId String?
  fantasyLocationId  String?
  country            String
  branch             String
  fantasyStatus      String
  labRaw             String?
  labNormalized      String?
  shape              String
  shapeNormalized    String?
  weight             Decimal
  weightBandId       String?
  weightBand         WeightBand? @relation(fields: [weightBandId], references: [id])
  color              String?
  clarity            String?
  certificate        String?
  treatment          String?
  planningClass      String   @default("PHYSICAL")
  lastUpdated        DateTime @default(now())
  createdAt          DateTime @default(now())
}

model RoughStone {
  id                  String   @id @default(cuid())
  fantasyRoughId     String   @unique
  kapan              String
  packet              String
  stoneName           String
  signer              String?
  stoneType           String   @default("WHITE") // WHITE | BLUE
  roughWeight         Decimal
  country             String
  branch              String
  fantasyDepartmentId String?
  fantasyLocationId  String?
  fantasyStatus       String
  planningEligible    Boolean  @default(true)
  planningStatus      String   @default("AVAILABLE")
  // AVAILABLE | SOFT_RESERVED | UNDER_PLANNING | PLAN_APPROVED | RESERVED | RELEASED | CANCELLED | RELEASED
  parentRoughId      String?
  lastMovement        DateTime?
  lastUpdated        DateTime @default(now())
  createdAt          DateTime @default(now())

  planningCases      PlanningCase[]
  reservations       RoughReservation[]
}

model RoughReservation {
  id            String   @id @default(cuid())
  roughId       String
  rough         RoughStone @relation(fields: [roughId], references: [id])
  planningCaseId String?
  planningCase  PlanningCase? @relation(fields: [planningCaseId], references: [id])
  status        String   @default("SOFT_RESERVED")
  reservedBy    String
  reservedAt    DateTime @default(now())
  releasedAt    DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  // Equals roughId while the reservation is active, NULL once released/cancelled.
  // The unique index makes a second active reservation of the same rough impossible.
  activeRoughKey String?  @unique
  reservedByUserId String?
}

// ---------------------------------------------------------------------------
// PLANNING CATEGORY, WEIGHT BANDS, MASTER MAPPINGS
// ---------------------------------------------------------------------------
model WeightBand {
  id         String    @id @default(cuid())
  code       String    @unique
  label      String
  minCt      Decimal
  maxCt      Decimal
  sortOrder  Int
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())

  salesRecords      SalesRecord[]
  polishedStones    PolishedStone[]
  salesOrderLines   SalesOrderLine[]
  requirements      Requirement[]
  planningCategories PlanningCategory[]
}

model LabMapping {
  id            String   @id @default(cuid())
  rawLab        String   @unique
  normalizedLab String   // GIA | Non-Cert | Other
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model ShapeMapping {
  id               String   @id @default(cuid())
  rawShape         String   @unique
  normalizedShape  String
  category         String?
  active           Boolean  @default(true)
  createdAt        DateTime  @default(now())
}

model PlanningCategory {
  id            String   @id @default(cuid())
  code          String   @unique
  labNormalized String
  shape         String
  weightBandId  String
  weightBand    WeightBand @relation(fields: [weightBandId], references: [id])
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
}

// ---------------------------------------------------------------------------
// DEMAND & REQUIREMENTS
// ---------------------------------------------------------------------------
model DemandCalculationLock {
  id               String    @id @default("DEMAND_CALCULATION")
  isLocked         Boolean   @default(false)
  lockToken        String?
  lockedAt         DateTime?
  lockedBy         String?
  lockedByUserId   String?
  runId            String?
  previousOwner    String?
  previousRunId    String?
  previousLockedAt DateTime?
  unlockReason     String?
  unlockedBy       String?
  unlockedAt       DateTime?
  updatedAt        DateTime  @updatedAt
}

model DemandRun {
  id                 String                  @id @default(cuid())
  runDate            DateTime                @default(now())
  windowDays         Int                     @default(90)
  ruleVersion        String                  @default("DEMAND-V1")
  status             String                  @default("COMPLETED") // RUNNING | COMPLETED | FAILED | PARTIAL | REVIEW_REQUIRED | BLOCKED_BY_DATA_QUALITY
  sourcePolicy       String                  @default("CANONICAL_FANTASY") // CANONICAL_FANTASY | LEGACY_SALES
  totalShortage      Int                     @default(0)
  totalExcess        Int                     @default(0)
  startedAt          DateTime                @default(now())
  finishedAt         DateTime?
  businessDateIst    String?
  lookbackStart      DateTime?
  lookbackEnd        DateTime?
  mappingVersion     String?
  mappingFingerprint String?
  lockToken          String?
  sourceMode         String                  @default("FIXTURE") // FIXTURE | FILE_IMPORT | FANTASY_API
  isSimulated        Boolean                 @default(true)
  checkpoint         Int                     @default(0)
  lastBatchId        String?
  sourceCutoff       DateTime?
  salesCount         Int                     @default(0)
  inventoryCount     Int                     @default(0)
  wipCount           Int                     @default(0)
  planCount          Int                     @default(0)
  excludedCount      Int                     @default(0)
  actor              String?
  actorUserId        String?
  errorSummary       String?
  durationMs         Int                     @default(0)
  createdAt          DateTime                @default(now())

  metrics            DemandMetric[]
  traceItems         DemandMetricTraceItem[]

  @@index([runDate])
  @@index([status])
}

model DemandMetric {
  id                   String     @id @default(cuid())
  runId                String
  run                  DemandRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  planningCategory     String
  labNormalized        String?
  shapeNormalized      String?
  weightBandCode       String?
  weightBandLabel      String?
  sales90d             Int
  monthlyAverage       Decimal
  unroundedTarget      Decimal
  roundedTarget        Int
  availableStock       Int
  memoQty              Int        @default(0)
  reservedQty          Int        @default(0)
  blockedQty           Int        @default(0)
  physicalShortage     Int
  excessStock          Int
  wipCoverage          Int        @default(0)
  unallocatedWip       Int        @default(0)
  pipelineNeed         Int
  approvedPlanCoverage Int        @default(0)
  remainingUnplanned   Int
  forecastSignal       Int        @default(0)
  status               String     @default("COMPLETED") // COMPLETED | REVIEW_REQUIRED | BLOCKED_BY_DATA_QUALITY
  traceJson            String?    // Legacy JSON support
  createdAt            DateTime   @default(now())

  @@index([runId])
  @@index([planningCategory])
}

model DemandMetricTraceItem {
  id               String     @id @default(cuid())
  runId            String
  run              DemandRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  demandMetricId   String?
  planningCategory String
  traceType        String     // SALE | STOCK | MEMO | RESERVED | BLOCKED | WIP_ELIGIBLE | WIP_UNALLOCATED | PLAN_APPROVED | EXCLUSION
  lotId            String?
  sourceRecordId   String?
  eventKey         String?
  quantity         Decimal    @default(1)
  weight           Decimal?
  lab              String?
  shape            String?
  weightBand       String?
  wipStage         String?
  customerName     String?
  saleTotalUsd     Decimal?
  docDate          DateTime?
  reason           String?
  isIncluded       Boolean    @default(true)
  checkpoint       Int?
  batchId          String?
  metadataJson     String?
  createdAt        DateTime   @default(now())

  @@index([runId, planningCategory])
  @@index([runId, traceType])
  @@index([lotId])
  @@index([eventKey])
}

model Requirement {
  id                  String   @id @default(cuid())
  requirementCode     String   @unique
  type                String   // STOCK_REPLENISHMENT | CUSTOMER_ORDER | BACKORDER | SPECIAL_REQUIREMENT | FORECAST | MANUAL_APPROVED
  status              String   @default("ACTIVE")
  // DRAFT | ACTIVE | PARTIALLY_COVERED | FULLY_PLANNED | IN_MANUFACTURING | PARTIALLY_FULFILLED | FULFILLED | ON_HOLD | CANCELLED | EXPIRED
  customerId          String?
  customerName        String?
  salesOrderId        String?
  orderNumber         String?
  groupCode           String
  companyCode         String
  country             String
  branch              String
  labNormalized       String?
  shape               String?
  weightBandId        String?
  weightBand          WeightBand? @relation(fields: [weightBandId], references: [id])
  colorGroup          String?
  clarityGroup        String?
  treatment           String?
  requiredQty         Int
  physicalStockQty    Int      @default(0)
  planningAvailableQty Int     @default(0)
  memoQty             Int      @default(0)
  transferCoverage    Int      @default(0)
  wipCoverage         Int      @default(0)
  approvedPlanCoverage Int     @default(0)
  actualCoverage      Int      @default(0)
  remainingUnplanned  Int      @default(0)
  forecastQty         Int      @default(0)
  requiredBy          DateTime?
  createdDate         DateTime @default(now())
  ageDays             Int      @default(0)
  daysRemaining       Int?
  daysOverdue         Int?
  customerPriority    String?
  orderPriority       String?
  requirementPriority String? // CRITICAL | HIGH | NORMAL | LOW | WATCH
  priorityReason      String?
  calculationRunId   String?
  businessRuleVersion String?
  sourceRecords       String? // JSON-serialized lineage
  createdBy           String?
  updatedBy           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  allocations         RequirementAllocation[]
}

model RequirementAllocation {
  id            String   @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id])
  plannedPieceId String?
  planOptionId  String?
  planOption    PlanOption? @relation(fields: [planOptionId], references: [id])
  allocatedQty  Int
  allocatedBy   String
  allocatedAt   DateTime @default(now())
  status        String   @default("ALLOCATED")
  createdAt     DateTime @default(now())
}

// ---------------------------------------------------------------------------
// PLANNING CASES, VERSIONS, OPTIONS, PIECES
// ---------------------------------------------------------------------------
model PlanningCase {
  id              String   @id @default(cuid())
  caseCode        String   @unique
  roughId         String
  rough           RoughStone @relation(fields: [roughId], references: [id])
  stoneName       String
  kapan           String
  packet          String
  originalRoughWeight Decimal
  stoneType       String   @default("WHITE")
  planner         String
  planningDate    DateTime @default(now())
  status          String   @default("DRAFT")
  // DRAFT | READY_FOR_REVIEW | SELECTED | APPROVAL_PENDING | APPROVED | RELEASED | REJECTED | CANCELLED | REPLAN_REQUIRED | SUPERSEDED
  currentVersion  Int      @default(1)
  requirementContext String?
  sourceFile      String?
  selectedOptionId String?
  approvedBy      String?
  approvedAt      DateTime?
  approvalComment String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  versions        PlanVersion[]
  reservations    RoughReservation[]
}

model PlanVersion {
  id              String   @id @default(cuid())
  planningCaseId  String
  planningCase    PlanningCase @relation(fields: [planningCaseId], references: [id])
  versionNumber   Int
  previousVersionId String?
  reason          String?
  status          String   @default("DRAFT")
  createdBy       String
  createdAt       DateTime @default(now())
  supersededAt    DateTime?
  options         PlanOption[]

  @@unique([planningCaseId, versionNumber])
}

model PlanOption {
  id                String   @id @default(cuid())
  optionCode       String   @unique
  versionId        String
  version          PlanVersion @relation(fields: [versionId], references: [id])
  optionNumber     Int
  expectedPieces   Int
  expectedTotalWeight Decimal
  yieldPct         Decimal
  matchingRequiredPieces Int @default(0)
  requirementCoverage Int   @default(0)
  coveragePct      Decimal  @default(0)
  nonRequiredPieces Int    @default(0)
  expectedColor    String?
  expectedClarity  String?
  certificationIntent String? // GIA | Non-Cert | Other | Undecided
  potentialExcess  Int      @default(0)
  validationWarnings String?
  selected         Boolean  @default(false)
  selectedBy       String?
  selectedAt       DateTime?
  approvalStatus   String   @default("DRAFT")
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime @default(now())

  pieces           PlanOptionPiece[]
  allocations      RequirementAllocation[]
  reconciliations PlanActualReconciliation[]
}

model PlanOptionPiece {
  id                String   @id @default(cuid())
  pieceCode        String   @unique
  planOptionId     String
  planOption        PlanOption @relation(fields: [planOptionId], references: [id])
  sequence         Int
  expectedShape    String
  expectedWeight   Decimal
  expectedColor    String?
  expectedClarity  String?
  expectedCategory String?
  requirementAllocationId String?
  certificationIntent String?
  fantasyChildId   String?
  actualPolishedLotId String?
  actualShape      String?
  actualWeight     Decimal?
  actualCategory   String?
  fulfilled        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// ACTUAL OUTPUTS, RECONCILIATION, PLAN-VS-ACTUAL
// ---------------------------------------------------------------------------
model ActualPolishedLink {
  id             String   @id @default(cuid())
  plannedPieceId String?
  fantasyPolishedLotId String
  actualShape     String
  actualWeight    Decimal
  actualCategory  String?
  actualYieldPct  Decimal?
  linkedAt        DateTime @default(now())
}

model PlanActualReconciliation {
  id                 String   @id @default(cuid())
  planOptionId       String
  planOption         PlanOption? @relation(fields: [planOptionId], references: [id])
  expectedPieces     Int
  actualPieces       Int      @default(0)
  expectedTotalWeight Decimal
  actualTotalWeight  Decimal  @default(0)
  plannedYieldPct    Decimal
  actualYieldPct     Decimal  @default(0)
  yieldVariance      Decimal  @default(0)
  expectedCoverage   Int
  actualCoverage     Int      @default(0)
  coverageVariance   Int      @default(0)
  status             String   @default("OPEN")
  reconciledAt       DateTime?
  createdAt          DateTime @default(now())
}

// ---------------------------------------------------------------------------
// FORECASTING & DATA SCIENCE
// ---------------------------------------------------------------------------
model ForecastRun {
  id           String   @id @default(cuid())
  modelVersion String
  runDate      DateTime @default(now())
  horizon30d   Int
  horizon60d   Int
  horizon90d   Int
  metricsJson  String?
  status       String  @default("COMPLETED")
  createdAt    DateTime @default(now())
  predictions  ForecastPrediction[]
}

model ForecastPrediction {
  id            String   @id @default(cuid())
  runId         String
  run           ForecastRun @relation(fields: [runId], references: [id])
  category      String
  prediction30d Int
  prediction60d Int
  prediction90d Int
  confidence    Decimal
  trend         String   // Strong Growth | Growth | Stable | Declining | Strong Decline | New | Dormant | Volatile
  stockoutRisk  String? // LOW | MEDIUM | HIGH | CRITICAL
  stockoutDate  DateTime?
  createdAt     DateTime @default(now())
}

model ModelVersion {
  id              String   @id @default(cuid())
  modelName       String   @unique
  version         String
  algorithm       String
  trainingPeriod  String
  validationPeriod String?
  metricsJson     String?
  publishedBy     String?
  publishedAt     DateTime?
  status          String   @default("DRAFT")
  createdAt       DateTime @default(now())
}

// ---------------------------------------------------------------------------
// BUSINESS RULES, FEATURE FLAGS, AUDIT, DATA QUALITY
// ---------------------------------------------------------------------------
model BusinessRule {
  id            String   @id @default(cuid())
  ruleId        String   @unique
  domain        String
  name          String
  version       String
  effectiveDate DateTime
  status        String   @default("PROPOSED") // CONFIRMED | PROPOSED | OPEN | DEPRECATED
  configuration String?  // JSON
  approvedBy    String?
  approvedAt    DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model FeatureFlag {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  enabled     Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  entity    String
  entityId  String?
  before    String?
  after     String?
  reason    String?
  timestamp DateTime @default(now())
  correlationId String?
  // Server-derived identity (never taken from the request body)
  actorUserId String?
  actorRole   String?
  requestId   String?
  sessionId   String?
  sourceIp    String?

  @@index([timestamp])
  @@index([actorUserId])
}

model DataQualityIssue {
  id               String    @id @default(cuid())
  issueCode        String    @unique
  source           String
  entity           String
  recordId         String?
  rule             String
  message          String
  severity         String   // INFO | WARNING | ERROR | BLOCKING
  status           String   @default("OPEN") // OPEN | IN_REVIEW | RESOLVED | IGNORED
  syncRunId        String?
  batchId          String?
  checkpoint       Int?
  affectedField    String?
  rawValue         String?
  normalizedValue  String?
  downstreamImpact String?
  detectedAt       DateTime @default(now())
  assignedTo       String?
  resolution       String?
  resolvedBy       String?
  resolvedAt       DateTime?

  @@index([source, status])
  @@index([batchId])
  @@index([rule])
  @@index([recordId])
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  title     String
  message   String
  severity  String   @default("INFO")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model IntegrationSyncRun {
  id                     String    @id @default(cuid())
  source                 String    // Fantasy
  entity                 String    // Department | Location | Rough | Polished | Movement | ALL | BATCH
  status                 String    // RUNNING | SUCCESS | FAILED | PARTIAL
  sourceMode             String    @default("FIXTURE") // FIXTURE | FILE_IMPORT | FANTASY_API
  isSimulated            Boolean   @default(true)
  batchId                String?
  startingCheckpoint     Int       @default(0)
  endingCheckpoint       Int       @default(0)
  sourceCutoff           DateTime?
  recordsReceived        Int       @default(0)
  recordsCreated         Int       @default(0)
  recordsUpdated         Int       @default(0)
  recordsUnchanged       Int       @default(0)
  recordsSkipped         Int       @default(0)
  recordsRejected        Int       @default(0)
  recordsRemoved         Int       @default(0)
  historyVersionsCreated Int       @default(0)
  dqIssuesCreated        Int       @default(0)
  recordsFetched         Int       @default(0)
  errorsJson             String?
  errorSummary           String?
  durationMs             Int       @default(0)
  triggeredBy            String?
  triggeredByUserId      String?
  startedAt              DateTime  @default(now())
  finishedAt             DateTime?
  nextRunAt              DateTime?

  @@index([startedAt])
  @@index([status])
  @@index([batchId])
}

model SyncCheckpoint {
  id                String    @id @default(cuid())
  source            String    @unique @default("FANTASY")
  mode              String    @default("FIXTURE") // FIXTURE | FILE_IMPORT | FANTASY_API
  currentCheckpoint Int       @default(0)
  lastBatchId       String?
  lastSyncAt        DateTime?
  isLocked          Boolean   @default(false)
  lockedAt          DateTime?
  lockedBy          String?
  updatedAt         DateTime  @updatedAt
}

model LotMasterRecord {
  id                  String    @id @default(cuid())
  lotId               String    @unique
  sourceRecordId      String?
  sourceType          String    @default("FIXTURE") // FIXTURE | FILE_IMPORT | FANTASY_API
  entityType          String    @default("POLISHED") // POLISHED | ROUGH | WIP | MEMO | INVOICE
  currentStatus       String    // STOCK | MEMO | INVOICE | SOLD | TRANSFERRED | ARCHIVED | CANCELLED | WIP_PLANNING | WIP_LASER | WIP_POLISHING | WIP_GRADING | WIP_COMPLETED | REMOVED_UNKNOWN
  previousStatus      String?
  statusEffectiveDate DateTime
  docDate             DateTime
  quantity            Decimal   @default(1)
  shape               String
  shapeNormalized     String?
  weight              Decimal
  color               String?
  clarity             String?
  labRaw              String?
  labNormalized       String?
  certificate         String?
  treatment           String?
  saleTotalUsd        Decimal?
  customerId          String?
  customerCode        String?
  customerName        String?
  departmentId        String?
  departmentName      String?
  locationId          String?
  locationName        String?
  country             String
  branch              String
  roughOrPolished     String    @default("POLISHED")
  wipStage            String?
  parentRoughId       String?
  kapan               String?
  stoneName           String?
  isCurrent           Boolean   @default(true)
  removalReason       String?   // EXPLICIT_SALE | MEMO_RETURN | TRANSFERRED | ARCHIVED | CANCELLED | COMPLETED | CORRECTION | SOURCE_DISAPPEARANCE_UNKNOWN
  removedFromLiveAt   DateTime?
  firstSeenAt         DateTime  @default(now())
  lastSeenAt          DateTime  @default(now())
  sourceCreatedAt     DateTime?
  sourceUpdatedAt     DateTime?
  currentVersion      Int       @default(1)
  lastSyncBatchId     String
  checkpoint          Int       @default(1)
  isSimulated         Boolean   @default(true)
  metadataJson        String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  history             LotHistoryRecord[]

  @@index([isCurrent])
  @@index([currentStatus])
  @@index([shapeNormalized])
  @@index([labNormalized])
  @@index([country, branch])
  @@index([lastSeenAt])
  @@index([checkpoint])
  @@index([sourceRecordId])
}

model LotHistoryRecord {
  id                  String    @id @default(cuid())
  lotId               String
  lotMaster           LotMasterRecord @relation(fields: [lotId], references: [lotId], onDelete: Restrict)
  sourceRecordId      String?
  version             Int
  status              String
  previousStatus      String?
  docDate             DateTime
  statusEffectiveDate DateTime
  quantity            Decimal   @default(1)
  shape               String
  shapeNormalized     String?
  weight              Decimal
  color               String?
  clarity             String?
  labRaw              String?
  labNormalized       String?
  certificate         String?
  treatment           String?
  saleTotalUsd        Decimal?
  customerId          String?
  customerCode        String?
  customerName        String?
  departmentId        String?
  departmentName      String?
  locationId          String?
  locationName        String?
  country             String
  branch              String
  roughOrPolished     String    @default("POLISHED")
  wipStage            String?
  parentRoughId       String?
  kapan               String?
  stoneName           String?
  isCurrent           Boolean
  removalReason       String?
  changeReason        String?
  syncBatchId         String
  checkpoint          Int
  isSimulated         Boolean   @default(true)
  metadataJson        String?
  recordedAt          DateTime  @default(now())

  @@unique([lotId, version])
  @@index([lotId])
  @@index([syncBatchId])
  @@index([checkpoint])
  @@index([status])
  @@index([recordedAt])
  @@index([sourceRecordId])
}

// ---------------------------------------------------------------------------
// IDENTITY — users and server-side sessions
// ---------------------------------------------------------------------------
model User {
  id               String    @id @default(cuid())
  username         String    @unique
  displayName      String
  email            String?   @unique
  passwordHash     String
  role             String    // role code, see src/lib/auth/permissions.ts
  status           String    @default("ACTIVE") // ACTIVE | DISABLED
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions         Session[]
}

// Self-service registration. A request NEVER creates an account or grants access:
// it is a queue item an administrator reviews and, on approval, provisions a User
// from with an explicitly chosen role. Nobody self-assigns permissions.
model AccessRequest {
  id               String    @id @default(cuid())
  username         String // requested sign-in name, lowercased
  displayName      String
  email            String?
  department       String?
  justification    String
  status           String    @default("PENDING") // PENDING | APPROVED | REJECTED
  // Equals the username while PENDING, NULL once decided. The unique index makes a
  // second open request for the same username impossible.
  pendingKey       String?   @unique
  createdUserId    String? // the User provisioned on approval
  reviewedBy       String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  decisionNote     String?
  sourceIp         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, createdAt])
}

model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique // sha-256 of the opaque cookie token; the token itself is never stored
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  ip         String?
  userAgent  String?

  @@index([userId])
}

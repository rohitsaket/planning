model User {
  id               String    @id @default(cuid())
  username         String    @unique
  displayName      String
  email            String?   @unique
  passwordHash     String
  /// Legacy single-role column. Retained during the transition and still written so an
  /// unmigrated reader keeps working; principal resolution prefers UserRole.
  role             String
  /// ACTIVE | SUSPENDED | DISABLED. A temporary login lockout (lockedUntil) is a
  /// failed-login consequence, not an administrative suspension.
  status           String    @default("ACTIVE")
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  /// Set when an administrator issues a temporary password. The session is restricted
  /// to identity, password change and logout until the user chooses a new one.
  mustChangePassword Boolean @default(false)
  passwordChangedAt  DateTime?
  suspendedAt        DateTime?
  deactivatedAt      DateTime?
  /// Optimistic concurrency. Every mutation supplies the version it read.
  version            Int      @default(0)
  createdByUserId    String?
  updatedByUserId    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions         Session[]
  roleAssignments  UserRole[]
  accessScopes     UserAccessScope[]

  @@index([status])
}

/// Which countries and labs a user is allowed to see.
///
/// One row per user, per dimension, per allowed value — deliberately not a delimited
/// string, so a value can be indexed, constrained, audited and revoked individually, and
/// so a country code containing the delimiter can never widen someone's access.
///
/// ABSENCE IS UNRESTRICTED. A user with no row for a dimension may see every value of it.
/// This is what makes the model additive: every account that existed before scoping keeps
/// exactly the access it had, and a narrower scope is an explicit act by someone holding
/// the authority to make it.
model UserAccessScope {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// COUNTRY | LAB. Validated against the vocabulary in src/lib/auth/access-scope.ts.
  dimension       String
  /// The exact stored value this user may see, for example "IN" or "GIA". Compared to the
  /// canonical column verbatim; it is never normalized on read.
  value           String
  /// Required by the assignment API: an access change always records why.
  reason          String?
  grantedByUserId String?
  createdAt       DateTime @default(now())

  @@unique([userId, dimension, value])
  @@index([userId, dimension])
}


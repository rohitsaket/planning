model FantasyClassificationProfile {
  id            String   @id @default(cuid())
  /// Stable profile identifier, e.g. LEGACY_FIXTURE or FIXTURE_RAW_TEST.
  code          String   @unique
  name          String
  description   String?
  /// SIMULATION_ONLY may never classify non-simulated data. LIVE_ELIGIBLE requires the
  /// client to have confirmed the vocabulary it encodes; none exists yet.
  applicability String
  /// Incremented on every mapping change. Stamped on every classified record so a past
  /// classification stays reproducible after the profile is edited.
  version       Int      @default(1)
  isActive      Boolean  @default(true)
  createdByUserId String?
  updatedByUserId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt


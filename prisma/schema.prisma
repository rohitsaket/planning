  sourceUpdatedAt     DateTime?
  currentVersion      Int       @default(1)
  lastSyncBatchId     String
  checkpoint          Int       @default(1)
  isSimulated         Boolean   @default(true)
  metadataJson        String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

